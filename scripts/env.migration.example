# Copy to .env.migration (project root) and fill in. Never commit the filled file.
#   copy scripts\env.migration.example .env.migration

# --- OLD system: Supabase -> Project Settings -> API ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "service_role" secret key (reads every table and private storage bucket)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: bucket name used when a column stores only a file path (e.g. "invoices/abc.pdf")
SUPABASE_STORAGE_BUCKET=

# --- NEW system: Amazon RDS MySQL (user needs SELECT, INSERT, UPDATE, DELETE) ---
DB_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=aems
DB_SSL=true

# --- NEW system: Amazon S3 ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=aems-attachments
# Leave empty when running on the EC2 box that has the S3 IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
